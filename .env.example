BOT_TOKEN=
OWNER_ID=
AUTH_USERS=
DOWNLOAD_LOCATION=./DOWNLOADS
CHUNK_SIZE=128
DOWNLOAD_THREADS=16
HTTP_PROXY=
TELEGRAM_PROXY=
TELEGRAM_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PROCESS_MAX_TIMEOUT=3700
AUTO_BEST_QUALITY=true
MAX_HEIGHT=1080
REQUEST_COOLDOWN_SECONDS=3
MAX_UPLOAD_BYTES=1992294400
VERIFY_SSL=true
# Gallery-dl probe timeout in seconds for Twitter/X posts (default 15).
GALLERY_PROBE_TIMEOUT=15
# Catalogue search defaults: deezer, spotify-web, tidal-web, pixiv, or pawchive (users can override in /settings).
SEARCH_PROVIDER=deezer
# Pawchive archive host override (default https://pawchive.pw; the site migrates domains).
PAWCHIVE_ROOT=https://pawchive.pw
# New-release follow polling interval in seconds (default six hours).
FOLLOW_POLL_SECONDS=21600
# Max source-URL entries in the persistent media file_id cache (default 5000).
MEDIA_CACHE_MAX_ENTRIES=5000
# Twitter/X 18+ posts: Netscape cookies file of a logged-in account (used by yt-dlp and gallery-dl).
# TWITTER_COOKIES_FILE=/absolute/path/to/cookies.txt  (preferred)
# Or paste the file content inline (multiline value is fine):
TWITTER_COOKIES=
# Pixiv: normally nothing to set — run `gallery-dl oauth:pixiv` once on this
# host and gallery-dl stores the token in its own cache and reuses it.
# Set this only to override that cache; it is passed through a temporary
# 0600 config file, never via argv.
PIXIV_REFRESH_TOKEN=
# Optional Netscape cookies.txt for pixiv.net (path or pasted content).
# Needed for some R18 works in profiles.
PIXIV_COOKIES=
# Music: Spotify links via mornye (see docs/adr/0002). Empty MORNYE_SERVICES
# disables the feature completely.
# Comma-separated provider extensions in priority order. Recommended with installed extensions:
# ext:tidal-web,ext:qobuz-web,ext:deezer (avoids Deezer stream resets when Tidal has the track).
# Requires a configured extension registry + installed extensions (~/.mornye).
MORNYE_SERVICES=ext:tidal-web,ext:qobuz-web,ext:deezer
# Extension registry JSON URL(s), comma-separated. None is built in.
# registry-python.json is required with mornye 2.x: it ships utilities.sflx,
# the signed-session/solver modules the music extensions now depend on.
MORNYE_REGISTRIES=https://raw.githubusercontent.com/mornyeapp/Mornye-Extension/main/registry-python.json,https://raw.githubusercontent.com/mornyeapp/Mornye-Extension/main/registry.json
# ZARZ Turnstile challenges require Chromium and Xvfb. Docker includes both and sets
# CHROME_PATH=/usr/bin/chromium; Compose also overrides host-specific values from this file.
# On bare metal, install chromium and xvfb; set this only if automatic discovery fails:
# CHROME_PATH=/usr/bin/chromium
# A Chromium-based alternative such as Helium can be selected with its executable path instead.
# Default audio tier: LOSSLESS (CD) or HI_RES_LOSSLESS (Hi-Res, falls back per
# track). Seeds each user's /settings choice; they can switch it per account.
MORNYE_QUALITY=LOSSLESS
# Optional transcode: empty = original FLAC; mp3 = MP3 320k (requires ffmpeg).
MORNYE_TRANSCODE=
# Keep built-in Deezer/Apple metadata without asking every installed JS extension.
# Set to 1 to opt into extension enrichment (may open one Turnstile browser per provider).
MORNYE_ENRICH_EXTENSIONS=0
# Max tracks downloaded per album/playlist/artist request.
SPOTIFY_COLLECTION_CAP=50
# mornye extensions' Node runtime blocks private/local addresses by default.
# Required behind a fakeip/tun VPN (e.g. sing-box) so extensions can reach the
# Internet: set to 1 to allow. Only enable if you trust the installed extensions.
MORNYE_EXT_ALLOW_PRIVATE_NETWORK=
# The bot's own SSRF guard rejects reserved ranges, which includes the
# 198.18.0.0/15 fakeip answers a sing-box/mihomo TUN setup returns for
# every host. Set to 1 behind such a VPN; only that range is exempt.
ALLOW_FAKEIP=
