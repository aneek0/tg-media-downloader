BOT_TOKEN=
OWNER_ID=
AUTH_USERS=
DOWNLOAD_LOCATION=./DOWNLOADS
CHUNK_SIZE=128
DOWNLOAD_THREADS=16
HTTP_PROXY=
TELEGRAM_PROXY=
TELEGRAM_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PROCESS_MAX_TIMEOUT=3700
AUTO_BEST_QUALITY=true
MAX_HEIGHT=1080
REQUEST_COOLDOWN_SECONDS=3600
MAX_UPLOAD_BYTES=1992294400
VERIFY_SSL=true
# Gallery-dl probe timeout in seconds for Twitter/X posts (default 15).
GALLERY_PROBE_TIMEOUT=15
# Twitter/X 18+ posts: Netscape cookies file of a logged-in account (used by yt-dlp and gallery-dl).
# TWITTER_COOKIES_FILE=/absolute/path/to/cookies.txt  (preferred)
# Or paste the file content inline (multiline value is fine):
TWITTER_COOKIES=
# Music: Spotify links via mornye (see docs/adr/0002). Empty MORNYE_SERVICES
# disables the feature completely.
# Comma-separated provider extensions in priority order (ext:deezer, ext:tidal-web, ...).
# Requires a configured extension registry + installed extensions (~/.mornye).
MORNYE_SERVICES=
# Extension registry JSON URL(s), comma-separated. None is built in.
MORNYE_REGISTRIES=https://raw.githubusercontent.com/mornyeapp/Mornye-Extension/main/registry.json
# Requested quality: LOSSLESS or HI_RES_LOSSLESS (falls back automatically).
MORNYE_QUALITY=LOSSLESS
# Optional transcode: empty = original FLAC; mp3 = MP3 320k (requires ffmpeg).
MORNYE_TRANSCODE=
# Max tracks downloaded per album/playlist/artist request.
SPOTIFY_COLLECTION_CAP=50
# mornye extensions' Node runtime blocks private/local addresses by default.
# Required behind a fakeip/tun VPN (e.g. sing-box) so extensions can reach the
# Internet: set to 1 to allow. Only enable if you trust the installed extensions.
MORNYE_EXT_ALLOW_PRIVATE_NETWORK=
